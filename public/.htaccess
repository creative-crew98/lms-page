# Entry documents must come from the server on every visit.
# Disable validators too: uploaded exports can retain old timestamps.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|txt)$">
        Header onsuccess unset Cache-Control
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header unset ETag
        Header always unset ETag
        Header unset Last-Modified
        Header always unset Last-Modified
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
</IfModule>
